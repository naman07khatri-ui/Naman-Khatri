<script>
  (function () {
    var root = document.getElementById('CustomHeader-{{ section_id }}');
    if (!root) return;

    var burger = root.querySelector('[data-header-open]');
    var closers = root.querySelectorAll('[data-header-close]');

    function setOpen(open) {
      root.classList.toggle('is-menu-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    burger.addEventListener('click', function () { setOpen(true); });
    closers.forEach(function (el) {
      el.addEventListener('click', function () { setOpen(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 989) setOpen(false);
    });
  })();
</script>

{% schema %}
{
  "name": "Custom Header",
  "tag": "section",
  "class": "section-custom-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (overrides logo text)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo image width",
      "min": 60,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Tisso Vison"
    },
    {
      "type": "checkbox",
      "id": "logo_uppercase",
      "label": "Uppercase logo text",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "label": "Logo text size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "logo_weight",
      "label": "Logo text weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "url",
