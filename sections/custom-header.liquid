  #CustomHeader-{{ section_id }} .header-drawer,
  #CustomHeader-{{ section_id }} .header-drawer-overlay {
    display: none;
  }

  @media (max-width: 989px) {
    #CustomHeader-{{ section_id }} .header-container {
      grid-template-columns: 1fr auto 1fr;
      gap: 12px;
    }

    /* hide center message + right button */
    #CustomHeader-{{ section_id }} .header-message,
    #CustomHeader-{{ section_id }} .header-action {
      display: none;
    }

    /* hamburger left */
    #CustomHeader-{{ section_id }} .header-burger {
      display: inline-flex;
      grid-column: 1;
    }

    /* logo center */
    #CustomHeader-{{ section_id }} .header-logo {
      grid-column: 2;
      justify-self: center;
    }

    /* drawer */
    #CustomHeader-{{ section_id }} .header-drawer-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      z-index: 998;
    }

    #CustomHeader-{{ section_id }} .header-drawer {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(var(--ch-drawer-w), 88vw);
      background: var(--ch-drawer-bg);
      color: var(--ch-drawer-color);
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      z-index: 999;
      overflow-y: auto;
    }

    #CustomHeader-{{ section_id }}.is-menu-open .header-drawer {
      transform: translateX(0);
    }

    #CustomHeader-{{ section_id }}.is-menu-open .header-drawer-overlay {
      opacity: 1;
      visibility: visible;
    }

    #CustomHeader-{{ section_id }} .header-drawer-top {
      display: flex;
      justify-content: flex-end;
      padding: 15px;
    }

    #CustomHeader-{{ section_id }} .header-drawer-close {
      width: 40px;
      height: 40px;
      padding: 0;
      background: none;
      border: 0;
      cursor: pointer;
      color: var(--ch-drawer-color);
    }

    #CustomHeader-{{ section_id }} .header-drawer-close svg {
      width: 22px;
      height: 22px;
    }

    #CustomHeader-{{ section_id }} .header-drawer-nav {
      list-style: none;
      margin: 0;
      padding: 0 20px 30px;
    }

    #CustomHeader-{{ section_id }} .header-drawer-nav a {
      display: block;
      padding: 14px 0;
      color: inherit;
      text-decoration: none;
      font-size: 17px;
      border-bottom: 1px solid rgba(128, 128, 128, 0.25);
