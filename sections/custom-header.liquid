{%- liquid
  assign section_id = section.id
  assign logo_link = section.settings.logo_link | default: routes.root_url
-%}

<style>
  #CustomHeader-{{ section_id }} {
    --ch-bg: {{ section.settings.bg_color }};
    --ch-border: {{ section.settings.border_color }};
    --ch-logo-color: {{ section.settings.logo_color }};
    --ch-logo-size: {{ section.settings.logo_text_size }}px;
    --ch-logo-img-w: {{ section.settings.logo_width }}px;
    --ch-msg-color: {{ section.settings.message_color }};
    --ch-msg-size: {{ section.settings.message_size }}px;
    --ch-btn-bg: {{ section.settings.button_bg }};
    --ch-btn-color: {{ section.settings.button_text_color }};
    --ch-btn-bg-h: {{ section.settings.button_bg_hover }};
    --ch-btn-color-h: {{ section.settings.button_text_hover }};
    --ch-btn-radius: {{ section.settings.button_radius }}px;
    --ch-py: {{ section.settings.padding_y }}px;
    --ch-maxw: {{ section.settings.max_width }}px;
  }

  #CustomHeader-{{ section_id }} .header-wrapper {
    background: var(--ch-bg);
    {% if section.settings.show_border %}
      border-bottom: 1px solid var(--ch-border);
    {% endif %}
    {% if section.settings.sticky %}
      position: sticky;
      top: 0;
      z-index: 100;
    {% endif %}
  }

  #CustomHeader-{{ section_id }} .header-container {
    max-width: var(--ch-maxw);
    margin: 0 auto;
    padding: var(--ch-py) 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
  }

  #CustomHeader-{{ section_id }} .header-logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--ch-logo-color);
    font-size: var(--ch-logo-size);
    font-weight: {{ section.settings.logo_weight }};
    letter-spacing: 0.02em;
    line-height: 1;

    {% if section.settings.logo_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  #CustomHeader-{{ section_id }} .header-logo img {
    width: var(--ch-logo-img-w);
    max-width: 100%;
    height: auto;
    display: block;
  }

  #CustomHeader-{{ section_id }} .header-message {
    justify-self: center;
    margin: 0;
    text-align: center;
    color: var(--ch-msg-color);
    font-size: var(--ch-msg-size);
    line-height: 1.4;
  }

  #CustomHeader-{{ section_id }} .header-message a {
    color: inherit;
    text-decoration: none;
  }

  #CustomHeader-{{ section_id }} .header-action {
    justify-self: end;
  }

  #CustomHeader-{{ section_id }} .header-button {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 14px 26px;
    background: var(--ch-btn-bg);
    color: var(--ch-btn-color);
    border: 1px solid var(--ch-btn-bg);
    border-radius: var(--ch-btn-radius);
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #CustomHeader-{{ section_id }} .header-button:hover {
    background: var(--ch-btn-bg-h);
    color: var(--ch-btn-color-h);
  }

  #CustomHeader-{{ section_id }} .header-button svg {
    width: 26px;
    height: 12px;
    transition: transform 0.25s ease;
  }

  #CustomHeader-{{ section_id }} .header-button:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 989px) {
    #CustomHeader-{{ section_id }} .header-container {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }

    #CustomHeader-{{ section_id }} .header-message {
      grid-column: 1 / -1;
      grid-row: 2;

      {% unless section.settings.show_message_mobile %}
        display: none;
      {% endunless %}
    }

    #CustomHeader-{{ section_id }} .header-button {
      padding: 10px 18px;
      font-size: 13px;
      gap: 12px;
    }
  }
</style>

<header
  id="CustomHeader-{{ section_id }}"
  class="site-header"
  data-section-id="{{ section_id }}"
>
  <div class="header-wrapper">
    <div class="header-container">

      {%- comment -%} Header logo {%- endcomment -%}
      <a class="header-logo" href="{{ logo_link }}">
        {%- if section.settings.logo_image != blank -%}
          {{
            section.settings.logo_image
            | image_url: width: 600
            | image_tag:
              loading: 'eager',
              widths: '200, 300, 400, 600',
              alt: section.settings.logo_text | default: shop.name
          }}
        {%- else -%}
          {{ section.settings.logo_text | default: shop.name | escape }}
        {%- endif -%}
      </a>

      {%- comment -%} Header center message {%- endcomment -%}
      {%- if section.settings.message != blank -%}
        <p class="header-message">
          {%- if section.settings.message_link != blank -%}
            <a href="{{ section.settings.message_link }}">
              {{ section.settings.message | escape }}
            </a>
          {%- else -%}
            {{ section.settings.message | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- comment -%} Header action button {%- endcomment -%}
      {%- if section.settings.button_label != blank -%}
        <div class="header-action">
          <a
            class="header-button"
            href="{{ section.settings.button_link | default: '#' }}"
            {% if section.settings.button_new_tab %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
            <span>{{ section.settings.button_label | escape }}</span>

            {%- if section.settings.show_arrow -%}
              <svg
                viewBox="0 0 26 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <path d="M0 6h24M19 1l5 5-5 5"/>
              </svg>
            {%- endif -%}
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Custom Header",
  "tag": "section",
  "class": "section-custom-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (overrides logo text)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo image width",
      "min": 60,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Tisso Vison"
    },
    {
      "type": "checkbox",
      "id": "logo_uppercase",
      "label": "Uppercase logo text",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "label": "Logo text size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "logo_weight",
      "label": "Logo text weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link (defaults to homepage)"
    },
    {
      "type": "header",
      "content": "Center message"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "url",
      "id": "message_link",
      "label": "Message link (optional)"
    },
    {
      "type": "range",
      "id": "message_size",
      "label": "Message size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_message_mobile",
      "label": "Show message on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "message_color",
      "label": "Message text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#f7ec4a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Button background (hover)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_hover",
      "label": "Button text (hover)",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}
