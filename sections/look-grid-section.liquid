{%- comment -%}
  Lookbook section for Shopify Dawn
  Save as: sections/lookbook.liquid
  Popup uses the native <dialog> element (black backdrop, Esc to close, focus handling built in).
{%- endcomment -%}

{%- style -%}
  .lookbook-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .lookbook-{{ section.id }} .lookbook__grid {
    --lb-gap: {{ section.settings.gap }}px;
    --lb-cols-mobile: {{ section.settings.columns_mobile }};
    --lb-cols-desktop: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div class="lookbook lookbook-{{ section.id }} page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="lookbook__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="lookbook__grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <div class="lookbook__item" {{ block.shopify_attributes }}>
        <div class="lookbook__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                widths: '300, 500, 700, 1000',
                sizes: '(min-width: 750px) 33vw, 50vw',
                class: 'lookbook__image'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook__image placeholder-svg' }}
          {%- endif -%}

          {%- if product != blank -%}
            <button
              type="button"
              class="lookbook__hotspot"
              style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;"
              aria-label="Quick view: {{ product.title | escape }}"
              aria-haspopup="dialog"
              data-lookbook-open="LookbookModal-{{ block.id }}"
            >
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
                <path d="M5 0v10M0 5h10" stroke="currentColor" stroke-width="1.4" fill="none"/>
              </svg>
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- for block in section.blocks -%}
    {%- assign product = block.settings.product -%}
    {%- if product != blank -%}
      {%- assign form_id = 'LookbookForm-' | append: block.id -%}
      <dialog id="LookbookModal-{{ block.id }}" class="lookbook-modal" aria-label="{{ product.title | escape }}">
        <button type="button" class="lookbook-modal__close" data-lookbook-close aria-label="{{ 'accessibility.close' | t }}">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
        </button>

        <div class="lookbook-modal__top">
          <div class="lookbook-modal__thumb">
            {%- assign thumb = product.featured_image | default: block.settings.image -%}
            {%- if thumb != blank -%}
              {{ thumb | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', alt: product.title }}
            {%- endif -%}
          </div>
          <div class="lookbook-modal__info">
            <p class="lookbook-modal__title">{{ product.title | escape }}</p>
            <p class="lookbook-modal__price" data-lookbook-price>
              {{ product.selected_or_first_available_variant.price | money }}
            </p>
            <p class="lookbook-modal__description">
              {{ product.description | strip_html | truncatewords: 25 }}
            </p>
          </div>
        </div>

        <form method="post" action="{{ routes.cart_add_url }}" id="{{ form_id }}" data-lookbook-form novalidate>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-lookbook-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name_down = option.name | downcase -%}
              <div class="lookbook-modal__option">
                {%- if option_name_down contains 'color' or option_name_down contains 'colour' -%}
                  <span class="lookbook-modal__label">{{ option.name | escape }}</span>
                  <div class="lookbook-modal__swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
                    {%- for value in option.values -%}
                      <input
                        type="radio"
                        id="{{ form_id }}-{{ option.position }}-{{ forloop.index0 }}"
                        name="{{ form_id }}-option-{{ option.position }}"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      <label
                        for="{{ form_id }}-{{ option.position }}-{{ forloop.index0 }}"
                        class="lookbook-modal__swatch"
                        style="--swatch-color: {{ value | handle }};"
                      >{{ value | escape }}</label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <label class="lookbook-modal__label" for="{{ form_id }}-select-{{ option.position }}">{{ option.name | escape }}</label>
                  <div class="lookbook-modal__select-wrap">
                    <select id="{{ form_id }}-select-{{ option.position }}" class="lookbook-modal__select">
                      <option value="" disabled selected>Choose your {{ option.name | downcase | escape }}</option>
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}">{{ value | escape }}</option>
                      {%- endfor -%}
                    </select>
                    <svg class="lookbook-modal__chevron" width="14" height="8" viewBox="0 0 14 8" aria-hidden="true" focusable="false">
                      <path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5" fill="none"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <p class="lookbook-modal__error" data-lookbook-error role="alert" hidden></p>

          <button type="submit" class="lookbook-modal__atc" data-lookbook-atc>
            <span>ADD TO CART</span>
            <svg width="30" height="10" viewBox="0 0 30 10" aria-hidden="true" focusable="false">
              <path d="M0 5h28M24 1l4 4-4 4" stroke="currentColor" stroke-width="1.2" fill="none"/>
            </svg>
          </button>
        </form>

        <script type="application/json" data-lookbook-variants>
          [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "options": {{ variant.options | json }},
                "available": {{ variant.available | json }},
                "price": {{ variant.price | money | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </dialog>
    {%- endif -%}
  {%- endfor -%}
</div>

{%- stylesheet -%}
  .lookbook__heading { margin: 0 0 2rem; }
  .lookbook__grid {
    display: grid;
    grid-template-columns: repeat(var(--lb-cols-mobile), 1fr);
    gap: var(--lb-gap);
  }
  @media screen and (min-width: 750px) {
    .lookbook__grid { grid-template-columns: repeat(var(--lb-cols-desktop), 1fr); }
  }
  .lookbook__media { position: relative; aspect-ratio: 1 / 1; overflow: hidden; }
  .lookbook__image { width: 100%; height: 100%; object-fit: cover; display: block; }

  .lookbook__hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 2.2rem; height: 2.2rem;
    border-radius: 50%;
    border: 0;
    background: rgba(255,255,255,.9);
    color: #000;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: transform .2s ease, background .2s ease;
    padding: 0;
  }
  .lookbook__hotspot:hover { transform: translate(-50%, -50%) scale(1.15); background: #fff; }
  .lookbook__hotspot:focus-visible { outline: 2px solid #000; outline-offset: 2px; }

  /* Popup (native <dialog>) */
  .lookbook-modal {
    border: 0;
    padding: 2rem 1.6rem 1.8rem;
    background: #fff;
    color: #000;
    width: calc(100% - 3rem);
    max-width: 34rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
  }
  .lookbook-modal::backdrop { background: #000; opacity: .9; }
  body:has(.lookbook-modal[open]) { overflow: hidden; }

  .lookbook-modal__close {
    position: absolute; top: 1rem; right: 1rem;
    background: none; border: 0; cursor: pointer; padding: .6rem; color: inherit;
  }
  .lookbook-modal__top { display: flex; gap: 1.2rem; margin-bottom: 1.6rem; }
  .lookbook-modal__thumb { flex: 0 0 11rem; max-width: 11rem; }
  .lookbook-modal__thumb img { width: 100%; height: auto; display: block; }
  .lookbook-modal__info { flex: 1; min-width: 0; }
  .lookbook-modal__title { margin: 0 0 1rem; font-size: 1.5rem; }
  .lookbook-modal__price { margin: 0 0 1rem; font-size: 1.8rem; font-family: var(--font-heading-family); }
  .lookbook-modal__description { margin: 0; font-size: 1.2rem; line-height: 1.4; }

  .lookbook-modal__option { margin-bottom: 1.4rem; }
  .lookbook-modal__label { display: block; font-size: 1.2rem; margin-bottom: .5rem; }
  .lookbook-modal__swatches { display: flex; }
  .lookbook-modal__swatches input { position: absolute; opacity: 0; pointer-events: none; }
  .lookbook-modal__swatch {
    flex: 1;
    border: 1px solid #000;
    border-left: 4px solid var(--swatch-color, #000);
    padding: .9rem 1rem;
    font-size: 1.5rem;
    cursor: pointer;
    background: #fff;
  }
  .lookbook-modal__swatches input:checked + .lookbook-modal__swatch { background: #f2f2f2; box-shadow: inset 0 0 0 1px #000; }
  .lookbook-modal__swatches input:focus-visible + .lookbook-modal__swatch { outline: 2px solid #000; outline-offset: 2px; }

  .lookbook-modal__select-wrap { position: relative; }
  .lookbook-modal__select {
    width: 100%;
    appearance: none; -webkit-appearance: none;
    border: 1px solid #000; border-radius: 0; background: #fff;
    padding: .9rem 4rem .9rem 1rem;
    font-size: 1.4rem; color: inherit; cursor: pointer;
  }
  .lookbook-modal__chevron { position: absolute; right: 1.4rem; top: 50%; transform: translateY(-50%); pointer-events: none; }

  .lookbook-modal__error { color: #b00020; font-size: 1.2rem; margin: 0 0 1rem; }
  .lookbook-modal__atc {
    width: 100%;
    display: flex; align-items: center; justify-content: center; gap: 1.6rem;
    background: #000; color: #fff; border: 0; cursor: pointer;
    padding: 1.4rem 1rem; font-size: 1.4rem; letter-spacing: .04em; margin-top: 2rem;
  }
  .lookbook-modal__atc[disabled] { opacity: .5; cursor: not-allowed; }
{%- endstylesheet -%}

{%- javascript -%}
  (function () {
    if (window.__lookbookInit) return;
    window.__lookbookInit = true;

    // Find the variant matching the currently selected options (null if incomplete / not found)
    function getVariant(form) {
      const variants = JSON.parse(form.closest('dialog').querySelector('[data-lookbook-variants]').textContent);
      const groups = form.querySelectorAll('.lookbook-modal__option');
      if (!groups.length) return variants[0];
      const selected = Array.from(groups, (g) => {
        const el = g.querySelector('select') || g.querySelector('input:checked');
        return el && el.value ? el.value : null;
      });
      if (selected.includes(null)) return null;
      return variants.find((v) => v.options.every((o, i) => o === selected[i]));
    }

    // Sync hidden variant id, price and button state
    function update(form) {
      const variant = getVariant(form);
      const atc = form.querySelector('[data-lookbook-atc]');
      form.querySelector('[data-lookbook-error]').hidden = true;
      form.querySelector('[data-lookbook-variant-id]').value = variant ? variant.id : '';
      // null = options not all chosen yet (button stays clickable to show a hint),
      // undefined = that combination doesn't exist, otherwise follow stock
      atc.disabled = variant === undefined || (!!variant && !variant.available);
      if (variant) form.closest('dialog').querySelector('[data-lookbook-price]').textContent = variant.price;
    }

    document.addEventListener('click', (e) => {
      const open = e.target.closest('[data-lookbook-open]');
      if (open) {
        const dialog = document.getElementById(open.dataset.lookbookOpen);
        update(dialog.querySelector('[data-lookbook-form]'));
        dialog.showModal();
      } else if (e.target.closest('[data-lookbook-close]') || e.target.matches('dialog.lookbook-modal')) {
        // close button, or click on the dialog's own backdrop area
        (e.target.closest('dialog') || e.target).close();
      }
    });

    document.addEventListener('change', (e) => {
      const form = e.target.closest('[data-lookbook-form]');
      if (form) update(form);
    });

    document.addEventListener('submit', async (e) => {
      const form = e.target.closest('[data-lookbook-form]');
      if (!form) return;
      e.preventDefault();

      const error = form.querySelector('[data-lookbook-error]');
      const atc = form.querySelector('[data-lookbook-atc]');
      const variant = getVariant(form);

      if (!variant) {
        error.textContent = 'Please choose all options before adding to cart.';
        error.hidden = false;
        return;
      }

      atc.disabled = true;
      try {
        const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        const body = { items: [{ id: variant.id, quantity: 1 }] };
        if (cart) {
          body.sections = cart.getSectionsToRender().map((s) => s.id).join(',');
          body.sections_url = window.location.pathname;
        }

        const res = await fetch(`${window.Shopify.routes.root}cart/add.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();

        if (!res.ok || data.status) {
          error.textContent = data.description || data.message || 'Could not add this item to the cart.';
          error.hidden = false;
        } else {
          form.closest('dialog').close();
          if (cart) cart.renderContents(data);
        }
      } catch (err) {
        error.textContent = 'Something went wrong. Please try again.';
        error.hidden = false;
      } finally {
        update(form);
      }
    });
  })();
{%- endjavascript -%}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns on mobile", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "gap", "label": "Gap between images", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Look image" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "hotspot_x", "label": "+ icon position (horizontal)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "hotspot_y", "label": "+ icon position (vertical)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "look" }, { "type": "look" }, { "type": "look" },
        { "type": "look" }, { "type": "look" }, { "type": "look" },
        { "type": "look" }, { "type": "look" }, { "type": "look" }
      ]
    }
  ]
}
{% endschema %}