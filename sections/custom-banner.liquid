{%- liquid
  assign sid = section.id
  assign btn_url = section.settings.button_link
-%}

<style>
  #CustomBanner-{{ sid }} {
    --cb-bg: {{ section.settings.bg_color }};
    --cb-heading: {{ section.settings.heading_color }};
    --cb-text: {{ section.settings.text_color }};
    --cb-btn-bg: {{ section.settings.button_bg }};
    --cb-btn-text: {{ section.settings.button_text_color }};
    --cb-btn-bg-hover: {{ section.settings.button_bg_hover }};
    --cb-btn-text-hover: {{ section.settings.button_text_hover }};
    --cb-strip-bg: {{ section.settings.strip_bg }};
    --cb-strip-text: {{ section.settings.strip_text_color }};
    --cb-overlay: {{ section.settings.overlay_color }};
    --cb-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cb-min-h: {{ section.settings.banner_height }}px;
    --cb-min-h-m: {{ section.settings.banner_height_mobile }}px;
    --cb-pt: {{ section.settings.padding_top }}px;
    --cb-pb: {{ section.settings.padding_bottom }}px;
    --cb-h-size: {{ section.settings.heading_size }}px;
    --cb-h-size-m: {{ section.settings.heading_size_mobile }}px;
    --cb-t-size: {{ section.settings.text_size }}px;
    --cb-content-w: {{ section.settings.content_width }}px;
    --cb-bg-size: {{ section.settings.bg_size }};
    --cb-bg-pos: {{ section.settings.bg_position }};
  }

  #CustomBanner-{{ sid }} .cb {
    position: relative;
    background-color: var(--cb-bg);
    overflow: hidden;
  }

  #CustomBanner-{{ sid }} .cb__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #CustomBanner-{{ sid }} .cb__bg img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.bg_fit }};
    object-position: var(--cb-bg-pos);
    display: block;
  }

  #CustomBanner-{{ sid }} .cb__overlay {
    position: absolute;
    inset: 0;
    background: var(--cb-overlay);
    opacity: var(--cb-overlay-opacity);
    z-index: 1;
    pointer-events: none;
  }

  #CustomBanner-{{ sid }} .cb__inner {
    position: relative;
    z-index: 2;
    min-height: var(--cb-min-h);
    padding: var(--cb-pt) 20px var(--cb-pb);
    display: flex;
    align-items: {{ section.settings.vertical_align }};
    justify-content: {{ section.settings.horizontal_align }};
    box-sizing: border-box;
  }

  #CustomBanner-{{ sid }} .cb__content {
    max-width: var(--cb-content-w);
    width: 100%;
    text-align: {{ section.settings.text_align }};
    {% if section.settings.show_content_box %}
    background: {{ section.settings.content_box_bg }};
    padding: 32px;
    {% endif %}
  }

  #CustomBanner-{{ sid }} .cb__heading {
    margin: 0 0 16px;
    font-size: var(--cb-h-size);
    line-height: 1.1;
    font-weight: {{ section.settings.heading_weight }};
    color: var(--cb-heading);
    {% if section.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
  }

  #CustomBanner-{{ sid }} .cb__text {
    margin: 0 0 28px;
    font-size: var(--cb-t-size);
    line-height: 1.6;
    color: var(--cb-text);
  }

  #CustomBanner-{{ sid }} .cb__text p { margin: 0 0 8px; }
  #CustomBanner-{{ sid }} .cb__text p:last-child { margin-bottom: 0; }

  #CustomBanner-{{ sid }} .cb__btn {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 16px 32px;
    background: var(--cb-btn-bg);
    color: var(--cb-btn-text);
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--cb-btn-bg);
    border-radius: {{ section.settings.button_radius }}px;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #CustomBanner-{{ sid }} .cb__btn:hover {
    background: var(--cb-btn-bg-hover);
    color: var(--cb-btn-text-hover);
  }

  #CustomBanner-{{ sid }} .cb__btn svg {
    width: 28px;
    height: 12px;
    transition: transform 0.25s ease;
  }

  #CustomBanner-{{ sid }} .cb__btn:hover svg { transform: translateX(4px); }

  #CustomBanner-{{ sid }} .cb__strip {
    position: relative;
    z-index: 2;
    background: var(--cb-strip-bg);
    color: var(--cb-strip-text);
    text-align: center;
    padding: 10px 20px;
    font-size: 14px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  #CustomBanner-{{ sid }} .cb__strip a { color: inherit; text-decoration: none; }

  @media (max-width: 749px) {
    #CustomBanner-{{ sid }} .cb__inner { min-height: var(--cb-min-h-m); }
    #CustomBanner-{{ sid }} .cb__heading { font-size: var(--cb-h-size-m); }
    #CustomBanner-{{ sid }} .cb__content { padding: {% if section.settings.show_content_box %}20px{% else %}0{% endif %}; }
    #CustomBanner-{{ sid }} .cb__text { font-size: 15px; }
  }
</style>

<section id="CustomBanner-{{ sid }}" class="custom-banner" data-section-id="{{ sid }}">
  <div class="cb">

    {%- if section.settings.bg_image != blank -%}
      <div class="cb__bg">
        {{
          section.settings.bg_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            alt: section.settings.bg_image.alt
        }}
      </div>
    {%- endif -%}

    <div class="cb__overlay"></div>

    <div class="cb__inner">
      <div class="cb__content">

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="cb__heading">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="cb__text rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            class="cb__btn"
            {% if btn_url != blank %}href="{{ btn_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
            {% if section.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
          >
            <span>{{ section.settings.button_label | escape }}</span>
            {%- if section.settings.show_arrow -%}
              <svg viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <path d="M0 6h26M21 1l5 5-5 5"/>
              </svg>
            {%- endif -%}
          </a>
        {%- endif -%}

      </div>
    </div>

    {%- if section.settings.strip_text != blank -%}
      <div class="cb__strip">
        {%- if section.settings.strip_link != blank -%}
          <a href="{{ section.settings.strip_link }}">{{ section.settings.strip_text | escape }}</a>
        {%- else -%}
          {{ section.settings.strip_text | escape }}
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section-custom-banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Bottom strip"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strip text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    },
    {
      "type": "url",
      "id": "strip_link",
      "label": "Strip link (optional)"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "bg_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Stretch" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "bg_size",
      "label": "Background size (reserved)",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner min height (desktop)",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Banner min height (mobile)",
      "min": 250,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "select",
      "id": "horizontal_align",
      "label": "Content position (horizontal)",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Content position (vertical)",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_content_box",
      "label": "Show content box behind text",
      "default": false
    },
    {
      "type": "color",
      "id": "content_box_bg",
      "label": "Content box color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Button background (hover)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_hover",
      "label": "Button text (hover)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "strip_bg",
      "label": "Strip background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "strip_text_color",
      "label": "Strip text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
