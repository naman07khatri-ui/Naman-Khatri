{%- liquid
  assign s = section.settings
-%}

<style>
  .cb {
    position: relative;
    background: var(--cb-bg);
    overflow: hidden;
  }

  .cb__bg,
  .cb__overlay {
    position: absolute;
    inset: 0;
  }

  .cb__bg {
    z-index: 0;
  }

  .cb__bg img,
  .cb__bg svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: var(--cb-fit);
    object-position: var(--cb-pos);
  }

  .cb__overlay {
    z-index: 1;
    background: var(--cb-overlay);
    opacity: var(--cb-overlay-opacity);
    pointer-events: none;
  }

  .cb__inner {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    display: flex;
    align-items: var(--cb-v-align);
    justify-content: var(--cb-h-align);
    min-height: var(--cb-min-h);
  }

  .cb__content {
    max-width: var(--cb-content-w);
    margin-bottom: 40px;
    width: 100%;
    text-align: var(--cb-text-align);
    {%- if s.show_content_box %}
    background: {{ s.content_box_bg }};
    padding: 32px;
    {%- endif %}
  }

  .cb__heading {
    margin: 0 0 16px;
    font-size: var(--cb-h-size);
    line-height: 1.1;
    font-weight: {{ s.heading_weight }};
    color: var(--cb-heading);
    text-transform: {% if s.heading_uppercase %}uppercase{% else %}none{% endif %};
  }

  .cb__text {
    margin: 0 0 28px;
    font-size: var(--cb-t-size);
    line-height: 1.6;
    color: var(--cb-text);
  }

  .cb__text p {
    margin: 0 0 8px;
  }

  .cb__text p:last-child {
    margin: 0;
  }

  .cb__btn {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 16px 32px;
    border: 1px solid currentColor;
    border-radius: var(--cb-radius);
    background: var(--cb-btn-bg);
    color: var(--cb-btn-text);
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .cb__btn:hover {
    background: var(--cb-btn-bg-hover);
    color: var(--cb-btn-text-hover);
  }

  .cb__btn svg {
    width: 28px;
    height: 12px;
    transition: transform 0.25s ease;
  }

  .cb__btn:hover svg {
    transform: translateX(4px);
  }

  .cb__strip {
    position: relative;
    z-index: 2;
    padding: 10px 20px;
    background: var(--cb-strip-bg);
    color: var(--cb-strip-text);
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }


  .cb__strip a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 749px) {
    .cb__inner {
      min-height: var(--cb-min-h-m);
    }

    .cb__heading {
      font-size: var(--cb-h-size-m);
    }

    {%- if s.show_content_box %}
    .cb__content {
      padding: 20px;
    }
    {%- endif %}
  }

     @media (max-width: 649px) {
    .cb__btn {
    padding: 12px 18px;
  }
  .cb__content{
     display: flex;
    flex-direction: column;
    height: 70vh;
    justify-content: space-between;
    align-items: center;
 padding-top: 30px;
  }
  .content{
    text-align: center;
  }
      .cb__text {
    font-size: 12px;
  }

     }
</style>

<div
  class="cb"
  style="
    --cb-bg: {{ s.bg_color }};
    --cb-heading: {{ s.heading_color }};
    --cb-text: {{ s.text_color }};
    --cb-btn-bg: {{ s.button_bg }};
    --cb-btn-text: {{ s.button_text_color }};
    --cb-btn-bg-hover: {{ s.button_bg_hover }};
    --cb-btn-text-hover: {{ s.button_text_hover }};
    --cb-strip-bg: {{ s.strip_bg }};
    --cb-strip-text: {{ s.strip_text_color }};
    --cb-overlay: {{ s.overlay_color }};
    --cb-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    --cb-min-h: {{ s.banner_height }}px;
    --cb-min-h-m: {{ s.banner_height_mobile }}px;
    --cb-pt: {{ s.padding_top }}px;
    --cb-pb: {{ s.padding_bottom }}px;
    --cb-h-size: {{ s.heading_size }}px;
    --cb-h-size-m: {{ s.heading_size_mobile }}px;
    --cb-t-size: {{ s.text_size }}px;
    --cb-content-w: {{ s.content_width }}px;
    --cb-radius: {{ s.button_radius }}px;
    --cb-fit: {{ s.bg_fit }};
    --cb-pos: {{ s.bg_position }};
    --cb-h-align: {{ s.horizontal_align }};
    --cb-v-align: {{ s.vertical_align }};
    --cb-text-align: {{ s.text_align }};
  "
>

{%- if s.bg_image != blank -%}
  <div class="cb__bg">
    {{
      s.bg_image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        alt: s.bg_image.alt,
        loading: 'lazy'
    }}
  </div>
{%- elsif request.design_mode -%}
  <div class="cb__bg">
    {{ 'lifestyle-1' | placeholder_svg_tag }}
  </div>
{%- endif -%}


  <div class="cb__overlay"></div>

  <div class="cb__inner page-width">
    <div class="cb__content">
<div class="content">
      {%- if s.heading != blank -%}
        <{{ s.heading_tag }} class="cb__heading">{{ s.heading | escape }}</{{ s.heading_tag }}>
      {%- endif -%}

      {%- if s.description != blank -%}
        <div class="cb__text">{{ s.description }}</div>
      {%- endif -%}
</div>

      {%- if s.button_label != blank -%}
        <a
          class="cb__btn"
          href="{{ s.button_link | default: '#' }}"
          {% if s.button_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          <span>{{ s.button_label | escape }}</span>
          {%- if s.show_arrow -%}
            <svg viewBox="0 0 28 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <path d="M0 6h26M21 1l5 5-5 5"/>
            </svg>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if s.strip_text != blank -%}
    <div class="cb__strip">
      {%- if s.strip_link != blank -%}
        <a href="{{ s.strip_link }}">{{ s.strip_text | escape }}</a>
      {%- else -%}
        {{ s.strip_text | escape }}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },

    { "type": "header", "content": "Button" },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    { "type": "header", "content": "Bottom strip" },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strip text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    },
    {
      "type": "url",
      "id": "strip_link",
      "label": "Strip link (optional)"
    },

    { "type": "header", "content": "Background" },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "bg_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Stretch" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner min height (desktop)",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Banner min height (mobile)",
      "min": 250,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "select",
      "id": "horizontal_align",
      "label": "Content position (horizontal)",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Content position (vertical)",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_content_box",
      "label": "Show content box behind text",
      "default": false
    },
    {
      "type": "color",
      "id": "content_box_bg",
      "label": "Content box color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },

    { "type": "header", "content": "Typography" },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "Button background (hover)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_hover",
      "label": "Button text (hover)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "strip_bg",
      "label": "Strip background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "strip_text_color",
      "label": "Strip text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}